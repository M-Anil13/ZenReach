# ───────────────────────────────────────────────────────────────────────────
# NexZen WhatsApp Campaign Suite — environment config
# Copy this file to ".env" and fill in only what you need. Lines starting with #
# are ignored. Real shell/OS environment variables always override these.
# ───────────────────────────────────────────────────────────────────────────

# ===== AI assist (pick ONE provider) ========================================
# Set the provider name + your key. Model is optional (each has a default).
# Known names: openai, groq, openrouter, together, deepseek, mistral, xai,
#              perplexity, fireworks, ollama, anthropic
LLM_PROVIDER=groq
LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile

# For ANY provider not listed above, set the OpenAI-compatible base URL directly:
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://api.your-llm.com/v1
# LLM_API_KEY=...
# LLM_MODEL=...

# Anthropic uses its own SDK (pip install anthropic):
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-4-8

# ===== SMTP (optional — sends real invite / reset emails) ===================
# Without these, invite links are still returned in the app (copy-paste them).
# SMTP_USER=you@yourdomain.com
# SMTP_PASS=your_mailbox_password
# SMTP_SERVER=smtp.hostinger.com
# SMTP_PORT=465

# ===== Meta webhooks (optional — enables real delivered/read tracking) ======
# NEXZEN_VERIFY_TOKEN=nexzen-verify
# NEXZEN_META_APP_SECRET=your_meta_app_secret

# ===== Embedded Signup (primary onboarding — needs Meta App Review) ==========
# Requires: registered Meta app, Embedded-Signup configuration id, Tech-Provider
# status, and Advanced Access for whatsapp_business_messaging + _management.
# Until set, the "Connect with Facebook" button is hidden and manual entry works.
# META_APP_ID=
# META_APP_SECRET=
# META_CONFIG_ID=

# ===== Secrets (optional — auto-generated if unset) =========================
# NEXZEN_SECRET_KEY=change-me-strong-random   # encrypts WhatsApp tokens at rest
# NEXZEN_FLASK_SECRET=change-me-random         # signs session cookies

# ===== Payments (optional — stubs until set) ================================
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# STRIPE_SECRET_KEY=
